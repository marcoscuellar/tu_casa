# TuCasa environment variables

# Server-side only. Used by api/parse-resume.ts to call Claude for résumé
# parsing. Set this in the Vercel project (Settings → Environment Variables),
# NOT in the client. It must never be exposed to the browser.
ANTHROPIC_API_KEY=

# Client flag (build-time). "1" turns on the live pipeline (real ATS boards +
# live résumé parsing). Anything else keeps the app on deterministic fixtures.
VITE_LIVE_JOBS=1
