{
  "name": "tucasa",
  "private": true,
  "version": "0.1.0",
  "description": "TuCasa — AI-powered job search, free for job seekers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-functions.mjs",
    "build:functions": "node scripts/bundle-functions.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@marcos/adhd-support": "github:marcoscuellar/adhd-support#v1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
